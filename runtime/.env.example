# Generate a fresh secret locally; never commit the populated .env file.
JAHIDS_HOST=127.0.0.1
JAHIDS_PORT=8787
JAHIDS_API_TOKEN=
JAHIDS_AUTONOMY_LEVEL=0
JAHIDS_DB_PATH=./data/jahids-runtime.sqlite3
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
JAHIDS_NIM_MODEL=minimaxai/minimax-m3.1-flash
JAHIDS_ENABLE_LOCAL_AGENTS=false
# Optional JSON argv arrays; the runtime appends the prompt as the last argument.
JAHIDS_OPENCLAW_ARGV=
JAHIDS_HERMES_ARGV=
